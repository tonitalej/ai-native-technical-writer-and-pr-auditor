# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
# Required in production. Development defaults to http://localhost:5173 when this is blank.
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Fallback for older Supabase projects that have not generated the keys above yet:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_OUTPUT_TOKENS=8000

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_MS=15000
GITHUB_SYNC_MAX_PAGES=10

AUDIT_WORKER_ENABLED=true
AUDIT_WORKER_INTERVAL_MS=2000
AUDIT_WORKER_CONCURRENCY=1
AUDIT_HEARTBEAT_INTERVAL_MS=15000
AUDIT_STALE_AFTER_SECONDS=120
AUDIT_MAX_ATTEMPTS=3
AUDIT_MAX_PROCESSING_MS=600000
AUDIT_MAX_DIFF_FETCH_BYTES=2000000
AUDIT_MAX_DIFF_ANALYZE_BYTES=300000
MAX_ACTIVE_AUDITS_PER_USER=3

SHUTDOWN_TIMEOUT_MS=30000

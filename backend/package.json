{
  "name": "ai-native-pr-auditor-backend",
  "version": "1.0.0",
  "private": true,
  "description": "V1 backend for AI-Native Codebase Technical Writer & PR Auditor",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "openai": "7.28.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}

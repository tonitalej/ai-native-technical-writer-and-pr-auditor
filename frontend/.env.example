# Copy to .env. Never commit .env.
# The frontend only receives public values. Do not put a secret key,
# service-role key, OpenAI key, or encryption key here.

VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). This is the browser-safe successor to the anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy name for the same browser key, used only when the publishable key is unset:
# VITE_SUPABASE_ANON_KEY=

VITE_API_URL=http://localhost:3000
